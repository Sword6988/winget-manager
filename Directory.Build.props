<Project>

  <!-- ═══════════════════════════════════════════════════════════════════
       全解决方案共享属性（见 docs/ARCHITECTURE.md §1.4）
       ═══════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA1031;CA1303;CA2007;CA1062</NoWarn>

    <!-- 中文文化感知行为必须保留：不要用 InvariantGlobalization=true「省体积」 -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- 未指定平台时默认 x64：WinUI 3 没有 AnyCPU 形态 -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- ───────────────────────────────────────────────────────────────────
       AOT 兼容策略（代码评审检查项，违反即回退）：

       1. UI 绑定一律 x:Bind；禁止 {Binding} / DataContext 反射路径 /
          带事件处理器的 XamlReader.Load。
       2. JSON 读写一律 System.Text.Json 源生成器：所有 DTO 在
          AppJsonContext 里用 [JsonSerializable] 注册，调用必须传
          AppJsonContext.Default.Xxx（全局禁用无 context 的重载）。
       3. 禁反射 API：dynamic、Activator.CreateInstance、Assembly.Load、
          Type.GetType(string)、BindingFlags 扫描。
       4. 编码：启动时 Encoding.RegisterProvider(CodePagesEncodingProvider.Instance)，
          之后才可用 gbk / cp936。
       5. TrimMode=full；不写 RD.xml（源生成注册已覆盖所需元数据）。
       ─────────────────────────────────────────────────────────────────── -->

</Project>
