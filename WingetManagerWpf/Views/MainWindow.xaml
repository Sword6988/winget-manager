<?xml version="1.0" encoding="utf-8"?>
<!--
    v3「清单工作台」主窗口。

    纵向四层（自上而下）：标题栏 44 → 命令条 56 → 列表（占满）→ 状态条 32。
    v2 的「副标题 + 4 统计卡 + 玻璃工具条 + 分组胶囊行 + 日志面板 + 底栏」六层
    被压成这四层：统计数字下沉进分段器，日志改按需抽屉，导出动作跟着选择浮出来。

    为什么用 WindowChrome 而不是 AllowsTransparency=True：
    后者会让整窗失去硬件加速（每帧走软件渲染），滚动长列表时肉眼可见地掉帧。
    WindowChrome 保留系统合成，同时把非客户区压成 0，视觉上仍是自定义标题栏。
-->
<Window x:Class="WingetManagerWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WingetManagerWpf.Controls"
        xmlns:core="clr-namespace:WingetManagerWpf.Core"
        Title="{x:Static core:Strings.WindowTitle}"
        Width="1240"
        Height="880"
        MinWidth="{x:Static core:Metrics.MinWidth}"
        MinHeight="{x:Static core:Metrics.MinHeight}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource FontFamily.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        StateChanged="OnWindowStateChanged">

    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0：标题栏完全自绘；ResizeBorderThickness=7：四边 7px 可拖拽缩放 -->
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="7"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- 三个固定行高与 Core/Metrics 保持一致：
                 RowDefinition.Height 是 GridLength，XAML 里不能直接吃 Metrics 的 double 常量
                 （{x:Static} 返回 double，不做隐式 GridLength 转换，会在加载时抛 XamlParseException），
                 所以这里写数值，并靠 .workbuddy/checks/check_csproj.py 的 REQUIRED_METRICS 守住一致性 -->
            <RowDefinition Height="44" />
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ══════════════════ 0. 标题栏 44 ══════════════════ -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="{StaticResource Brush.Card}"
              MouseLeftButtonDown="OnTitleBarMouseDown">

            <StackPanel Margin="16,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- BrandMark：渐变圆角方 + 白色「下载到托盘」图标 -->
                <Border Width="22"
                        Height="22"
                        CornerRadius="7"
                        Background="{StaticResource Brush.AccentGradient}">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="12" Height="12">
                            <Path Fill="#FFFFFFFF" Data="M5,1 H7 V6 H9.2 L6,9.2 L2.8,6 H5 Z" />
                            <Path Stroke="#FFFFFFFF"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M1.5,10.2 H10.5" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <controls:GradientText x:Name="TitleGradient"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       TextFontSize="{StaticResource FontSize.Titlebar}"
                                       Bold="True" />

                <Border Margin="8,0,0,0"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource Corner.Tag}"
                        Background="{StaticResource Brush.ChipBg}">
                    <TextBlock x:Name="TagText"
                               FontSize="{StaticResource FontSize.Micro}"
                               Foreground="{StaticResource Brush.Muted2}" />
                </Border>

                <!-- 分隔：标题区与扫描状态之间 -->
                <Border Width="1"
                        Height="13"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource Brush.Line}" />

                <!-- 副标题并入状态胶囊：v2 的 80 高副标题区就为了这一句 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ScanDot"
                             Width="5"
                             Height="5"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Accent}" />
                    <TextBlock x:Name="SubtitleText"
                               MaxWidth="520"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource FontSize.Status}"
                               Foreground="{StaticResource Brush.Muted}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="AboutButton" Content="ⓘ" Style="{StaticResource Button.WindowButton}" />
                <Button x:Name="MinimizeButton" Content="─" Style="{StaticResource Button.WindowButton}" />
                <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource Button.WindowButton}" />
                <Button x:Name="CloseWindowButton" Content="✕" Style="{StaticResource Button.WindowClose}" />
            </StackPanel>

            <Border Height="1"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource Brush.Line}" />
        </Grid>

        <!-- ══════════════════ 1. 命令条 56 ══════════════════ -->
        <Grid Grid.Row="1" Background="{StaticResource Brush.Card}">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="150" MaxWidth="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 搜索框：放大镜与占位文字是覆盖层，TextBox 只用 Padding 让位 -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Search}" />

                    <Path Width="13"
                          Height="13"
                          Margin="13,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          Stroke="{StaticResource Brush.Muted2}"
                          StrokeThickness="1.6"
                          Data="M9.2,9.2 L12.6,12.6 M0.9,5.6 A4.7,4.7 0 1 1 10.3,5.6 A4.7,4.7 0 1 1 0.9,5.6" />

                    <TextBlock x:Name="SearchPlaceholder"
                               Margin="35,0,32,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource FontSize.Body}"
                               Foreground="{StaticResource Brush.Muted2}" />

                    <Button x:Name="ClearSearchButton"
                            Width="22"
                            Height="22"
                            Margin="0,0,7,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="✕"
                            FontSize="{StaticResource FontSize.Chip}"
                            Visibility="Collapsed"
                            Style="{StaticResource Button.WindowButton}" />
                </Grid>

                <!-- 分组筛选：计数随搜索联动（faceted），由代码填充按钮 -->
                <Border Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="3"
                        VerticalAlignment="Center"
                        Background="{StaticResource Brush.SegTrack}"
                        CornerRadius="{StaticResource Corner.Inner}">
                    <StackPanel x:Name="CategoryHost" Orientation="Horizontal" />
                </Border>

                <!-- 弹性空隙：窄窗时先压这一段，不压控件内边距 -->
                <Border Grid.Column="2" />

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- 视图三态：与左侧分组筛选同一套「轨道 + 白底胶囊」语言，
                         原来这里是「浅蓝底 + 蓝字」，同一行出现两种「我选中了」的表达 -->
                    <Border Padding="3"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.SegTrack}"
                            CornerRadius="{StaticResource Corner.Inner}">
                        <StackPanel x:Name="ViewHost" Orientation="Horizontal" VerticalAlignment="Center" />
                    </Border>

                    <Border Width="1"
                            Height="16"
                            Margin="8,0,6,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.Line}" />

                    <Button x:Name="ScanButton"
                            Margin="2,0,4,0"
                            Style="{StaticResource Button.Outline}" />

                    <Button x:Name="MoreButton"
                            Content="⋯"
                            FontSize="15"
                            ToolTip="更多操作"
                            Style="{StaticResource Button.Icon}" />
                </StackPanel>
            </Grid>

            <Border Height="1"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource Brush.Line}" />
        </Grid>

        <!-- ══════════════════ 2. 列表区（+ 浮层） ══════════════════ -->
        <Grid Grid.Row="2">
            <Border x:Name="ListCard"
                    Margin="16,10,16,10"
                    Background="{StaticResource Brush.Card}"
                    BorderBrush="{StaticResource Brush.Line}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="{StaticResource Corner.Card}">
                <Grid>
                    <ScrollViewer x:Name="ListScroll"
                                  Padding="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnListScrollChanged">
                        <StackPanel x:Name="SectionsHost" Margin="0,2,0,8" />
                    </ScrollViewer>

                    <!-- 吸顶头：列表 Grid 的覆盖层，不参与滚动 -->
                    <controls:StickyGroupHeader x:Name="StickyHeader" Panel.ZIndex="20" />

                    <!--
                        底部渐隐 28px：卡片高度不是行高（48）的整数倍，最后一行必然被下沿切一半，
                        字被切断看起来像渲染错误。渐变把它提前收掉，比加 padding 更自然
                        （padding 会在列表滚到底时留一条突兀的空白）。
                        右边 10px 让给滚动条，避免把滚动条也虚化。
                    -->
                    <Border Height="28"
                            Margin="0,0,10,0"
                            VerticalAlignment="Bottom"
                            Panel.ZIndex="15"
                            IsHitTestVisible="False"
                            Background="{StaticResource Brush.ListFade}" />

                    <controls:EmptyStatePanel x:Name="EmptyPanel" Panel.ZIndex="10" />
                    <controls:SkeletonPanel x:Name="Skeleton" Panel.ZIndex="5" />

                    <!-- 扫描进度条：卡内底部 2px，不占布局高度 -->
                    <controls:MiniProgress x:Name="ScanProgress"
                                           Height="2"
                                           VerticalAlignment="Bottom"
                                           Panel.ZIndex="30"
                                           Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 浮动选择条：跟着选择出现，动作就在视线下方 -->
            <Border x:Name="SelectionBar"
                    Height="{x:Static core:Metrics.SelectionBarHeight}"
                    Margin="16,0,16,24"
                    Padding="14,0,7,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="40"
                    Visibility="Collapsed"
                    Background="{StaticResource Brush.Bar}"
                    CornerRadius="{StaticResource Corner.SelectionBar}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="6"
                                      Opacity="0.28"
                                      Color="{StaticResource Color.ShadowFx}" />
                </Border.Effect>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedCountText"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.BarText}" />
                    <TextBlock x:Name="SelectedSuffixText"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Status}"
                               Foreground="{StaticResource Brush.BarText2}" />

                    <Border Width="1"
                            Height="20"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.BarLine}" />

                    <Button x:Name="InvertButton" Style="{StaticResource Button.BarText}" />
                    <Button x:Name="ClearSelectionButton" Style="{StaticResource Button.BarText}" />

                    <Border Width="1"
                            Height="20"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.BarLine}" />

                    <Button x:Name="ExportButton" Style="{StaticResource Button.BarPrimary}" />
                </StackPanel>
            </Border>

            <!-- Toast：撤销 / 导出成功。位置在选择条上方 2px，不互相遮挡 -->
            <Border x:Name="ToastBar"
                    Margin="16,0,16,78"
                    Padding="14,0"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="50"
                    Visibility="Collapsed"
                    Background="{StaticResource Brush.Bar}"
                    CornerRadius="{StaticResource Corner.Bar}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="4"
                                      Opacity="0.24"
                                      Color="{StaticResource Color.ShadowFx}" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ToastText"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Aux}"
                               Foreground="{StaticResource Brush.BarText}" />
                    <Button x:Name="ToastActionButton"
                            Margin="8,0,0,0"
                            Content="撤销"
                            Visibility="Collapsed"
                            Foreground="{StaticResource Brush.BarText}"
                            FontWeight="SemiBold"
                            Style="{StaticResource Button.BarText}" />
                </StackPanel>
            </Border>

            <!-- 日志抽屉：从底部覆盖列表，不挤压它（滚动位置与焦点都不动） -->
            <Border x:Name="LogDrawer"
                    Margin="16,0,16,10"
                    Height="{x:Static core:Metrics.LogDrawerHeight}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="45"
                    Visibility="Collapsed">
                <!-- 抽屉是覆盖层：列表内容在它上沿必然被切一半。
                     加重投影（0.20→0.28）让它读作「浮在上面的一块板」，而不是「内容被剪掉了」 -->
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26"
                                      ShadowDepth="-4"
                                      Opacity="0.28"
                                      Color="{StaticResource Color.ShadowFx}" />
                </Border.Effect>
                <controls:LogPanelControl x:Name="LogPanel" />
            </Border>
        </Grid>

        <!-- ══════════════════ 3. 状态条 32 ══════════════════ -->
        <Grid Grid.Row="3" Background="{StaticResource Brush.Card}">
            <Border Height="1" VerticalAlignment="Top" Background="{StaticResource Brush.Line}" />

            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    左侧用 Grid 而不是 StackPanel：横向 StackPanel 给子元素的是无限宽度，
                    TextTrimming 永远不触发，960 窄窗时文案会直接顶到右侧信息簇上
                    （实测「导出配置」和 Local\WingetManager 贴在一起）。
                    Grid 的星列才会把可用宽度算出来，截断与省略号才真正生效。
                -->
                <Grid Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusDot"
                             Grid.Column="0"
                             Width="5"
                             Height="5"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource Brush.Muted3}" />

                    <TextBlock x:Name="StatusLabel"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Cursor="Hand"
                               ToolTip="展开运行日志"
                               Style="{StaticResource Text.Status}" />

                    <!-- 警告徽章：抽屉收起时也必须能看见「有 1 个警告」 -->
                    <Button x:Name="LogBadgeButton"
                            Grid.Column="2"
                            Height="19"
                            Margin="10,0,0,0"
                            Padding="6,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            FontSize="{StaticResource FontSize.Micro}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Brush.Warn}"
                            Background="{StaticResource Brush.WarnBg}"
                            Style="{StaticResource Button.Icon}"
                            Width="Auto" />
                </Grid>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DataDirText"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontFamily.Mono}"
                               FontSize="{StaticResource FontSize.Micro}"
                               Foreground="{StaticResource Brush.Muted3}" />

                    <Border Width="1"
                            Height="12"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.Line}" />

                    <TextBlock x:Name="WingetVersionText"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontFamily.Mono}"
                               FontSize="{StaticResource FontSize.Micro}"
                               Foreground="{StaticResource Brush.Muted3}" />

                    <Border Width="1"
                            Height="12"
                            Margin="10,0,8,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brush.Line}" />

                    <Button x:Name="LogToggleButton"
                            Width="Auto"
                            Height="22"
                            Padding="7,0"
                            VerticalAlignment="Center"
                            Content="⚑ 日志"
                            FontSize="{StaticResource FontSize.Micro}"
                            Style="{StaticResource Button.Icon}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
