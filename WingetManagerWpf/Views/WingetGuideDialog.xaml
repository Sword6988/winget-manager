<?xml version="1.0" encoding="utf-8"?>
<!--
    winget 缺失引导框。无边框 + 半透明外层，靠卡片自带阴影浮在父窗口上。
    注意：AllowsTransparency=True 必须配 WindowStyle=None，否则 WPF 会抛
    「AllowsTransparency 要求 WindowStyle=None」的 InvalidOperationException。
-->
<Window x:Class="WingetManagerWpf.Views.WingetGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="未检测到 winget"
        Width="528"
        Height="380"
        SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="{StaticResource FontFamily.Ui}"
        TextOptions.TextFormattingMode="Ideal">

    <!-- 高度策略：SizeToContent=Manual + 380 初值，Loaded 里由 DialogSizer 收到精确高度
         （DetailText 会带 winget 报错摘要，长度不定，所以不能写死高度） -->
    <Border x:Name="RootBorder"
            Margin="18"
            Background="{StaticResource Brush.Card}"
            BorderBrush="{StaticResource Brush.Line}"
            BorderThickness="1"
            CornerRadius="{StaticResource Corner.Card}"
            MouseLeftButtonDown="OnDragArea">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26"
                              ShadowDepth="8"
                              Opacity="0.16"
                              Color="{StaticResource Color.ShadowFx}" />
        </Border.Effect>

        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 + 关闭 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="未检测到 winget"
                           FontSize="{StaticResource FontSize.DialogTitle}"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.Text}" />

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        ContentTemplate="{StaticResource Glyph.Window.Close}"
                        Style="{StaticResource Button.WindowButton}" />
            </Grid>

                <TextBlock x:Name="IntroText"
                           Grid.Row="1"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           FontSize="{StaticResource FontSize.Body}"
                           Foreground="{StaticResource Brush.Muted}" />

            <TextBlock x:Name="DetailText"
                       Grid.Row="2"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       FontSize="{StaticResource FontSize.Aux}"
                       Foreground="{StaticResource Brush.Muted2}" />

            <!-- 按钮行 -->
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CopyHint"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Chip}"
                           Foreground="{StaticResource Brush.AccentDeep}"
                           Visibility="Collapsed" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="StoreButton" Style="{StaticResource Button.Primary}" />
                    <Button x:Name="CopyLinkButton"
                            Margin="10,0,0,0"
                            Style="{StaticResource Button.Outline}" />
                    <Button x:Name="OkButton"
                            Margin="10,0,0,0"
                            Style="{StaticResource Button.Outline}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
