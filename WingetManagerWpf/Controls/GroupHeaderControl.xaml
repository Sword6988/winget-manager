<?xml version="1.0" encoding="utf-8"?>
<!--
    分组头（36 高，v3 从 42 收窄：省下的高度全给列表）。整行点一下折叠/展开，右侧一个按钮负责批量勾选本组。
    左右内边距与行一致（16 / 14），保证「勾选框列」和「分组标题」在同一条竖线上。
-->
<UserControl x:Class="WingetManagerWpf.Controls.GroupHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WingetManagerWpf.Controls"
             xmlns:core="clr-namespace:WingetManagerWpf.Core"
             Height="{x:Static core:Metrics.GroupHeaderHeight}"
             Background="Transparent"
             SnapsToDevicePixels="True">

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource Color.HeadTop}" Offset="0" />
                <GradientStop Color="{StaticResource Color.HeadBot}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="16,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 折叠三角：展开时转 90°（朝下），折叠时 0°（朝右） -->
            <Path x:Name="Chevron"
                  Grid.Column="0"
                  Width="5"
                  Height="9"
                  Margin="0,0,9,0"
                  VerticalAlignment="Center"
                  Stroke="{StaticResource Brush.Muted2}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Data="M0.5,0.5 L4.5,4.5 L0.5,8.5">
                <Path.RenderTransform>
                    <RotateTransform x:Name="ChevronRotate" CenterX="2.5" CenterY="4.5" Angle="0" />
                </Path.RenderTransform>
            </Path>

            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource FontFamily.Ui}"
                       FontSize="{StaticResource FontSize.Body}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text}" />

            <controls:CountPill x:Name="Pill"
                                Grid.Column="2"
                                Margin="9,0,0,0" />

            <!--
                一个按钮顶原来的「全选本组 / 全不选」两个链接：文字始终描述**下一步动作**，
                当前状态由左侧「已选/总数」胶囊负责回答。MinWidth 固定，避免文字在 4 字 / 3 字之间
                切换时按钮宽度跳动、把「再点一次撤销」打成落空。
            -->
            <Button x:Name="GroupAction"
                    Grid.Column="4"
                    MinWidth="76"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="全选本组"
                    Style="{StaticResource Button.GroupAction}" />
        </Grid>
    </Grid>
</UserControl>
