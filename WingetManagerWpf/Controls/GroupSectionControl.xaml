<?xml version="1.0" encoding="utf-8"?>
<!--
    一个分组 = 分组头 + 该组的行。折叠时只是把行容器隐藏，
    **不销毁行控件** —— 展开时不用重新绑定，也不会有滚动位置跳变。
-->
<UserControl x:Class="WingetManagerWpf.Controls.GroupSectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WingetManagerWpf.Controls"
             Background="Transparent">

    <StackPanel x:Name="Host">
        <controls:GroupHeaderControl x:Name="HeaderView" />
        <StackPanel x:Name="RowHost" />
    </StackPanel>
</UserControl>
