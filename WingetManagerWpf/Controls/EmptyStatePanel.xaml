<?xml version="1.0" encoding="utf-8"?>
<!--
    空态面板：72 圆 + 放大镜 + 两行说明 + 「清除筛选」按钮。
    六种文案由 Strings 提供，这里只负责画。
-->
<UserControl x:Class="WingetManagerWpf.Controls.EmptyStatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- 72 圆底 + 放大镜：放在同一个 Grid 里居中叠放，
             用负边距叠层会在 StackPanel 里被压扁，不可靠 -->
        <Grid Width="72" Height="72" HorizontalAlignment="Center">
            <Ellipse Fill="{StaticResource Brush.AccentSoft}" />

            <Grid Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="17"
                         Height="17"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="4,5,0,0"
                         Stroke="{StaticResource Brush.Accent}"
                         StrokeThickness="2" />
                <Path Data="M18.5,19.5 L25,26"
                      Stroke="{StaticResource Brush.Accent}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Grid>
        </Grid>

        <TextBlock x:Name="MessageText"
                   Width="460"
                   Margin="0,16,0,0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontFamily="{StaticResource FontFamily.Ui}"
                   FontSize="{StaticResource FontSize.Body}"
                   LineHeight="22"
                   Foreground="{StaticResource Brush.Muted}" />

        <Button x:Name="ClearButton"
                Height="36"
                Padding="18,0"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Content="清除筛选"
                Visibility="Collapsed"
                Style="{StaticResource Button.Outline}" />
    </StackPanel>
</UserControl>
