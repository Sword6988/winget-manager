<?xml version="1.0" encoding="utf-8"?>
<!--
    控件样式（阶段一只落「按钮 / 搜索框 / 滚动条 / 提示 / 右键菜单」这几类通用件）。
    控件级样式（行、分组头、统计卡…）在阶段二随控件一起补，避免这里先写一堆没人用的样式。
    所有颜色都从 Tokens.xaml 取，样式里不出现字面色值。

    关于各 ControlTemplate 里重复出现的 x:Name="Bd"（共 10 处）：
    每个 ControlTemplate 是独立的 XAML namescope，同名不冲突；Trigger 的 TargetName="Bd"
    也只在所属模板内解析。这是 WPF 模板的惯用写法（统一指代「底框」），不是重复定义，无需改名。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设计器单独打开本文件时也要能解析令牌，故再合并一次（WPF 按 URI 去重，不会重复实例化） -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ══════════════════ 基础文本样式 ══════════════════ -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.Aux" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Aux}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    </Style>

    <!-- ══════════════════ 按钮：主 / 次 / 柔和 ══════════════════ -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="{StaticResource Brush.AccentGradient}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Corner.Bar}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentGradientHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentDeep}" />
                        </Trigger>
                        <!-- 键盘焦点环：Tab 到主按钮时可见（鼠标点击不触发，不干扰普通操作） -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.RowAlt}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Muted2}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Outline" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Corner.Bar}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush.Line}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.RowHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentLine}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Muted2}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Card}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Soft" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Aux}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="Background" Value="{StaticResource Brush.ChipBg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Corner.Row}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.AccentDeep}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentLine}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Muted3}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 胶囊按钮（分组筛选）：选中态用渐变填充 + 白字，未选中是白底细描边 -->
    <Style x:Key="Button.Pill" TargetType="ToggleButton">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Corner.Pill}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush.Line}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentLine}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentGradient}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════ 搜索框 ══════════════════ -->
    <!--
        内边距必须由模板里的 Border 提供，不能走 TextBox.Padding。
        TextBox 自己的 Padding 会被 TextBoxView 再消费一次，和 PART_ContentHost
        的 Margin 叠加，导致输入的第一个字符被推远一倍（实测 34 → 70.4 DIP）。
        所以这里把 Padding 钉死为 0，缩进只在 Border.Padding 里写一份。
    -->
    <Style x:Key="TextBox.Search" TargetType="TextBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Background" Value="{StaticResource Brush.GlassInput}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.AccentSoft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Padding="34,0,10,0"
                            CornerRadius="{StaticResource Corner.Bar}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush.Line}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentLine}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Card}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Muted2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════ 滚动条（10px 圆角、无箭头） ══════════════════ -->
    <ControlTemplate x:Key="Template.ScrollBar.Vertical" TargetType="ScrollBar">
        <Grid Background="Transparent" Width="12">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb>
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="Bd" Margin="3,0" CornerRadius="4"
                                        Background="{StaticResource Brush.Scroll}" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.ScrollHi}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Template.ScrollBar.Horizontal" TargetType="ScrollBar">
        <Grid Background="Transparent" Height="12">
            <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb>
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="Bd" Margin="0,3" CornerRadius="4"
                                        Background="{StaticResource Brush.Scroll}" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.ScrollHi}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- 隐式样式：全应用（列表、日志、胶囊行）统一滚动条外观 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource Template.ScrollBar.Vertical}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template" Value="{StaticResource Template.ScrollBar.Horizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════ ToolTip ══════════════════ -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Brush.Card}"
                            BorderBrush="{StaticResource Brush.Line}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Corner.Tag}"
                            Padding="9,6"
                            MaxWidth="420">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════ 右键菜单 ══════════════════ -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Aux}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Brush.Card}"
                            BorderBrush="{StaticResource Brush.Line}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Corner.Bar}"
                            Padding="5">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单项目前只有叶子节点（复制/勾选），故只调内边距与配色，保留默认模板 -->
    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Aux}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Brush.LineSoft}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,4" />
    </Style>

    <!-- ══════════════════ 卡片 / 玻璃容器 ══════════════════ -->
    <Style x:Key="Border.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Corner.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Border.Glass" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Glass}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Corner.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ══════════════════ 标题栏窗口按钮（ⓘ — □ ✕） ══════════════════ -->
    <!-- 30×28、hover 圆角 7：Windows 自己的标题按钮是直角，但我们整窗都是圆角卡片，
         直角按钮会显得像贴上去的，故统一给圆角 -->
    <Style x:Key="Button.WindowButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Aux}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.RowAlt}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Line}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮：hover 变红底白字（与 Windows 惯例一致，用户扫一眼就知道哪个能关） -->
    <Style x:Key="Button.WindowClose" TargetType="Button" BasedOn="{StaticResource Button.WindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Err}" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Err}" />
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════ 文字链接 ══════════════════ -->
    <Style x:Key="Text.Link" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Chip}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentDeep}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 「仅看已选」开关：选中态是淡紫底 + 深紫字，和主按钮的实心渐变区分开 -->
    <Style x:Key="Button.ToggleSoft" TargetType="ToggleButton">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Aux}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Corner.Bar}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush.Line}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentLine}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentLine}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.AccentDeep}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Muted3}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ══════════════════ v3「清单工作台」新增组件 ══════════════════ -->

    <!--
        键盘导航专用焦点环。
        WPF 的 FocusVisualStyle 只在键盘导航（Tab / 方向键）时显示，鼠标点击不显示——
        这正是分段器需要的语义：以前模板里用 IsKeyboardFocused 改 BorderBrush，
        鼠标点一下就把「已选中」的灰描边刷成蓝框，旁边同样选中的按钮却没有框，
        同一排两个按钮出现两种样子。现在焦点环只留给键盘用户，且内缩 1px，
        不会覆盖选中态自己的描边。
    -->
    <Style x:Key="FocusRing.Inset" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1"
                            CornerRadius="{StaticResource Corner.Tag}"
                            BorderBrush="{StaticResource Brush.Accent}"
                            BorderThickness="1.5"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 命令条里的分组分段器：轨道式，选中项为白底胶囊 + 描边 -->
    <Style x:Key="Button.Segment" TargetType="ToggleButton">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inset}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Seg}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Corner.Tag}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SegOn}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.SegOnLine}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Muted3}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        视图三态（全部 / 已选 / 未选）直接用 Button.Segment。
        v3.4 删掉了原来的 Button.ViewSeg：它把选中态画成「浅蓝底 + 蓝字」，
        与左侧分组筛选的「白底胶囊 + 描边」并列在同一条命令条上，
        同一行出现两种「我选中了」的表达。现在两边只差字号与位置，不再有第二套语言。
    -->

    <!-- 图标按钮（⋯ / 日志 / 状态条动作）：30×30 幽灵按钮 -->
    <Style x:Key="Button.Icon" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Corner.Tag}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.ChipBg}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Muted3}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 浮动选择条上的次级文字按钮（反选 / 清空） -->
    <Style x:Key="Button.BarText" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Seg}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.BarText2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Corner.Tag}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.BarHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.BarText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 选择条主按钮：实心底色不跟随主题变浅（深色主题下 accent 会提到亮蓝，白字只剩 2.54:1） -->
    <Style x:Key="Button.BarPrimary" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Seg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="{StaticResource Brush.BrandSolid}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Corner.Bar}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.BrandSolidHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.RowAlt}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Muted2}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分组头批量勾选按钮：文字描述下一步动作（全选本组 ⇄ 全不选），状态由计数胶囊承担 -->
    <Style x:Key="Button.GroupAction" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Chip}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentDeep}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Corner.Tag}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 状态条文字 -->
    <Style x:Key="Text.Status" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Status}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

</ResourceDictionary>
