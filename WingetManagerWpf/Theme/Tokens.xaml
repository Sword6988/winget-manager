<?xml version="1.0" encoding="utf-8"?>
<!--
    设计令牌（颜色 / 字体 / 字号 / 圆角 / 间距）—— v4「Win11 原生」重设计。
    键名是全局约定：所有控件只许引用这些键，**不得**再写字面色值，
    否则主题一旦调整就会出现「改了令牌但界面没变」的幽灵。

    v4 与 v3「清朗 Azure」的差异（改造目标：贴近 Win11 原生、克制中性）：
    · 品牌蓝由 Tailwind 系 #2563EB → Win11 系统蓝 #0067C0（hover #1976C5 / pressed #005BA1）
    · 中性色脱掉蓝调：页面底 #F3F3F3（mica 浅色）、卡片白、分隔线 #E5E5E5、正文 #1B1B1B
    · 全部渐变画刷改为实色（键名保留、类型换成 SolidColorBrush）——
      AccentGradient / AccentGradientHover 被标题、按钮、胶囊、统计卡共用，
      一处改实色，全应用收敛为「一处 accent、其余中性」
    · 浮动选择条由深色面改为白色浮层（Win11 浮出面板语言），文字/描边令牌同步反转
    · 圆角阶 12/9/8/6 → 8/6/4：卡片 8、输入与按钮 4、胶囊保持全圆
    · 字体 / 字号 / 间距沿用 v3（Segoe UI Variable + 4px 栅格），交互结构零变更

    v3 备注（仍然成立）：
    · 新增 Brush.RowSelected（勾选行底色）与 Brush.FocusRing（键盘焦点环）
    · 新增 Thickness.Page / PageTop / PageGap / Page（紧凑版）响应式页面边距令牌，
      由 MainWindow 在 ActualWidth < 1080 时切换为紧凑值（DynamicResource 引用）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════════ 颜色（Color，写渐变/动画时要用） ══════════════ -->
    <Color x:Key="Color.Accent">#FF0067C0</Color>
    <Color x:Key="Color.AccentDeep">#FF005BA1</Color>
    <Color x:Key="Color.Accent2">#FF2E7BC4</Color>
    <Color x:Key="Color.Bg">#FFF3F3F3</Color>
    <!-- 分组头/吸顶头的底色渐变端点（GradientStop.Color 只吃 Color，不吃 Brush） -->
    <Color x:Key="Color.HeadTop">#FFFFFFFF</Color>
    <Color x:Key="Color.HeadBot">#FFF7F7F7</Color>
    <!-- 阴影色（对话框/工具条 DropShadowEffect 的 Color 属性） -->
    <Color x:Key="Color.ShadowFx">#FF000000</Color>
    <!-- 键盘焦点环（GradientStop/Effect 只吃 Color 的场合） -->
    <Color x:Key="Color.FocusRing">#FF6BA9DF</Color>

    <!-- ══════════════ 基础画刷 ══════════════ -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Line" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="Brush.LineSoft" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#FF5E5E5E" />
    <SolidColorBrush x:Key="Brush.Muted2" Color="#FF979797" />
    <SolidColorBrush x:Key="Brush.Muted3" Color="#FFC7C7C7" />

    <!-- ══════════════ 品牌色 ══════════════ -->
    <!-- Win11 系统蓝三阶：base / pressed(深) / 亮阶（保留给未来需要两档蓝的场合） -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF0067C0" />
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#FF005BA1" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#FF2E7BC4" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FFE9F1F9" />
    <SolidColorBrush x:Key="Brush.AccentLine" Color="#FFC6DAEE" />
    <!-- v4：渐变退役。键名保留（引用方零改动），值换成实色 —— hover 为 Win11 的 +5% 提亮阶 -->
    <SolidColorBrush x:Key="Brush.AccentGradient" Color="#FF0067C0" />
    <SolidColorBrush x:Key="Brush.AccentGradientHover" Color="#FF1976C5" />

    <!-- ══════════════ 语义色 ══════════════ -->
    <SolidColorBrush x:Key="Brush.Warn" Color="#FF9C6B00" />
    <SolidColorBrush x:Key="Brush.WarnBg" Color="#FFFFF7E2" />
    <SolidColorBrush x:Key="Brush.WarnLine" Color="#FFF1E3BC" />
    <SolidColorBrush x:Key="Brush.Err" Color="#FFC42B1C" />

    <!-- ══════════════ 行状态 ══════════════ -->
    <SolidColorBrush x:Key="Brush.RowHover" Color="#FFF6F6F6" />
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#FFF1F1F1" />
    <!-- 勾选行底色：勾选不只反映在复选框上，整行淡淡铺一层 accent 浅底，
         扫一眼就知道哪些会被导出（可用性改进 #1） -->
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#FFE4EEF8" />
    <SolidColorBrush x:Key="Brush.NameOff" Color="#FF979797" />
    <SolidColorBrush x:Key="Brush.IdOff" Color="#FFB5B5B5" />

    <!-- ══════════════ 键盘焦点 ══════════════ -->
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#FF6BA9DF" />

    <!-- ══════════════ 标签（来源 / 置灰） ══════════════ -->
    <SolidColorBrush x:Key="Brush.TagSrcFg" Color="#FF005BA1" />
    <SolidColorBrush x:Key="Brush.TagSrcBg" Color="#FFE9F1F9" />
    <SolidColorBrush x:Key="Brush.TagSrcLine" Color="#FFC6DAEE" />
    <SolidColorBrush x:Key="Brush.TagDimFg" Color="#FF979797" />
    <SolidColorBrush x:Key="Brush.TagDimBg" Color="#FFF4F4F4" />
    <SolidColorBrush x:Key="Brush.TagDimLine" Color="#FFE9E9E9" />

    <!-- ══════════════ 容器表面（工具条 / 输入框底） ══════════════ -->
    <!-- v4：假玻璃全部落成实白，边界靠描边表达（Win11 输入框语言） -->
    <SolidColorBrush x:Key="Brush.Glass" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.GlassBorder" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="Brush.GlassInput" Color="#FFFFFFFF" />

    <!-- ══════════════ 日志面板 ══════════════ -->
    <SolidColorBrush x:Key="Brush.LogBg" Color="#FFF7F7F7" />
    <SolidColorBrush x:Key="Brush.LogFg" Color="#FF3B3B3B" />
    <SolidColorBrush x:Key="Brush.LogTs" Color="#FF9B9B9B" />
    <SolidColorBrush x:Key="Brush.LogHead" Color="#FF5E5E5E" />
    <SolidColorBrush x:Key="Brush.LogAct" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="Brush.LogOk" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="Brush.LogSkip" Color="#FF0E639C" />
    <SolidColorBrush x:Key="Brush.LogFail" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Brush.LogDone" Color="#FF0067C0" />

    <!-- ══════════════ 滚动条 ══════════════ -->
    <SolidColorBrush x:Key="Brush.Scroll" Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="Brush.ScrollHi" Color="#FFA6A6A6" />

    <!-- ══════════════ 胶囊 / 头部渐变 / 骨架屏 ══════════════ -->
    <SolidColorBrush x:Key="Brush.ChipBg" Color="#FFEFEFEF" />
    <SolidColorBrush x:Key="Brush.HeadTop" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.HeadBot" Color="#FFF7F7F7" />
    <SolidColorBrush x:Key="Brush.PillRing" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="Brush.PillRingFull" Color="#FF7FB2DE" />
    <SolidColorBrush x:Key="Brush.GradH1" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="Brush.GradH2" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Brush.Skel1" Color="#FFE9E9E9" />
    <SolidColorBrush x:Key="Brush.Skel2" Color="#FFF2F2F2" />

    <!-- ══════════════ 搜索命中高亮 ══════════════ -->
    <SolidColorBrush x:Key="Brush.HighlightBg" Color="#FFF6E39A" />
    <SolidColorBrush x:Key="Brush.HighlightFg" Color="#FF6B5300" />

    <!-- ══════════════ 实心主按钮专用 ══════════════ -->
    <!-- Win11 accent 按钮三阶：base #0067C0（白字 5.9:1）/ hover +5% 提亮 / pressed 压深。
         实心底一律用 base，白字对比度达标；亮蓝只用于文字/描边。 -->
    <SolidColorBrush x:Key="Brush.BrandSolid" Color="#FF0067C0" />
    <SolidColorBrush x:Key="Brush.BrandSolidHover" Color="#FF1976C5" />

    <!-- 浮动选择条：v4 改为白色浮层（Win11 浮出面板语言），阴影承担「浮」的表达 -->
    <SolidColorBrush x:Key="Brush.Bar" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.BarText" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="Brush.BarText2" Color="#FF5E5E5E" />
    <SolidColorBrush x:Key="Brush.BarLine" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="Brush.BarHover" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Brush.BarOnSelected" Color="#FFF0F0F0" />

    <!--
        命令条里的分段器轨道与选中底（三层明度差拉开，
        125% DPI 下 1px 描边不被抗锯齿吃掉）：
          轨道 #ECECEC → 选中底 #FFFFFF（差 22）→ 描边 #D9D9D9（差 24）
    -->
    <SolidColorBrush x:Key="Brush.SegTrack" Color="#FFECECEC" />
    <SolidColorBrush x:Key="Brush.SegOn" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SegOnLine" Color="#FFD9D9D9" />

    <!--
        未勾选复选框的描边：白底 + 1.5px #767676（4.5:1，
        超过 WCAG 1.4.11 对非文本控件的 3:1 门槛）。
    -->
    <SolidColorBrush x:Key="Brush.CheckLine" Color="#FF767676" />
    <SolidColorBrush x:Key="Brush.CheckFill" Color="#FFFFFFFF" />

    <!--
        列表底部渐隐。卡片高度不是行高整数倍，最后一行必然被下沿切一半，
        「字被切断」看起来像渲染错误，用 28px 渐变把它收掉。
        透明端是 #00FFFFFF（= Brush.Card 的透明版本），换主题时这一条要跟着改。
    -->
    <LinearGradientBrush x:Key="Brush.ListFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- 状态条 / Toast -->
    <SolidColorBrush x:Key="Brush.ToastOk" Color="#FF0F7B0F" />

    <!-- v3 字号：标题栏收小（44 高的标题栏装不下 24px 标题），状态条压到 11.5 -->
    <sys:Double x:Key="FontSize.Titlebar">13.5</sys:Double>
    <sys:Double x:Key="FontSize.Seg">12</sys:Double>
    <sys:Double x:Key="FontSize.Status">11.5</sys:Double>
    <sys:Double x:Key="FontSize.Micro">10.5</sys:Double>

    <CornerRadius x:Key="Corner.SelectionBar">8</CornerRadius>
    <CornerRadius x:Key="Corner.Menu">8</CornerRadius>

    <!-- ══════════════ 字体 ══════════════ -->
    <!-- 逗号分隔即回退链；Segoe UI Variable 在最前（Win11 自带），
         西文走 Fluent 原生字形、中文回退雅黑，混排更协调 -->
    <FontFamily x:Key="FontFamily.Ui">Segoe UI Variable Text, Segoe UI, HarmonyOS Sans SC, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="FontFamily.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!--
        ══════════════ 字号 ══════════════
        按信息层级排布（详见 docs/UI-DESIGN.md §3）：
        · 标题/正文加大半级到一级，长会话阅读更省力；ID/标签等辅助信息维持小号
        · 全部取 0.5 的倍数，保证 100%/125%/150% 缩放下不会出现半像素模糊
    -->
    <sys:Double x:Key="FontSize.Title">24</sys:Double>
    <sys:Double x:Key="FontSize.Sub">12.5</sys:Double>
    <sys:Double x:Key="FontSize.Row">13.5</sys:Double>
    <sys:Double x:Key="FontSize.RowId">11.5</sys:Double>
    <sys:Double x:Key="FontSize.Tag">11</sys:Double>
    <sys:Double x:Key="FontSize.Log">11.5</sys:Double>

    <!-- 兼容旧键名（对话框标题 / 统计数字 / 正文 / 辅助 / 小字） -->
    <sys:Double x:Key="FontSize.DialogTitle">21</sys:Double>
    <sys:Double x:Key="FontSize.Stat">22</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Aux">12.5</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>

    <sys:Double x:Key="FontSize.StatsNumber">22</sys:Double>
    <sys:Double x:Key="FontSize.Chip">12</sys:Double>
    <sys:Double x:Key="FontSize.Bottom">12.5</sys:Double>

    <!-- ══════════════ 圆角 ══════════════ -->
    <!-- v4 圆角阶：8 / 6 / 4（Win11 原生语言：窗口与卡片 8、控件 4、胶囊全圆） -->
    <CornerRadius x:Key="Corner.Card">8</CornerRadius>
    <CornerRadius x:Key="Corner.Bar">4</CornerRadius>
    <CornerRadius x:Key="Corner.Row">4</CornerRadius>
    <CornerRadius x:Key="Corner.Tag">4</CornerRadius>
    <CornerRadius x:Key="Corner.Pill">15</CornerRadius>
    <CornerRadius x:Key="Corner.Inner">6</CornerRadius>

    <!-- ══════════════ 间距（4px 栅格） ══════════════ -->
    <sys:Double x:Key="Space.Page">24</sys:Double>
    <sys:Double x:Key="Space.Card">16</sys:Double>
    <sys:Double x:Key="Space.Row">8</sys:Double>

    <!--
        ══════════════ 响应式页面边距（v2 新增） ══════════════
        MainWindow.xaml 用 DynamicResource 引用这组 Thickness；
        MainWindow 在 ActualWidth ≥ 1080 时写舒适值、< 1080 时写紧凑值，
        实现「同一份 XAML，宽窄窗都有合理留白」。compact 版也在此给出默认值，
        保证设计器预览与运行首帧一致。
    -->
    <Thickness x:Key="Thickness.Page">24,0,24,0</Thickness>
    <Thickness x:Key="Thickness.PageTop">24,12,24,0</Thickness>
    <Thickness x:Key="Thickness.PageGap">24,10,24,0</Thickness>
    <Thickness x:Key="Thickness.PageCompact">14,0,14,0</Thickness>
    <Thickness x:Key="Thickness.PageTopCompact">14,8,14,0</Thickness>
    <Thickness x:Key="Thickness.PageGapCompact">14,8,14,0</Thickness>

    <!--
        ══════════════ 关于「没有被引用的令牌」 ══════════════
        下列令牌当前没有任何 StaticResource / TryFindResource 引用，但**不要删**：
        它们是设计令牌契约的一部分（docs/ARCHITECTURE.md §3 的令牌表 +
        .workbuddy/checks/check_csproj.py 的 REQUIRED_TOKEN_KEYS），删掉会让静态自查直接 FAIL，
        也会让「改主题只改 Tokens」这条约定失效（例如 Color.* 是给后续画笔代码取值用的口径）。

        Color.Accent / Color.AccentDeep / Color.Accent2 / Color.Bg
        Brush.Accent2 / Brush.HeadTop / Brush.HeadBot / Brush.GradH1 / Brush.GradH2
        FontSize.Sub / Space.Page / Space.Card / Space.Row
    -->

</ResourceDictionary>
