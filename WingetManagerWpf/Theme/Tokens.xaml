<?xml version="1.0" encoding="utf-8"?>
<!--
    设计令牌（颜色 / 字体 / 字号 / 圆角 / 间距）—— v2「清朗 Azure」重设计。
    键名是全局约定：所有控件只许引用这些键，**不得**再写字面色值，
    否则主题一旦调整就会出现「改了令牌但界面没变」的幽灵。

    v2 与原版（qt_common.py 的靛紫玻璃拟态）的差异见 docs/UI-DESIGN.md：
    · 主色由靛紫 #6366F1→#8B5CF6 改为 Azure 蓝 #2563EB→#0EA5E9（白底对比度 ≥ 4.5:1，可达 WCAG AA）
    · 中性色整体压深一档（页面底 #F3F5F9、正文 #101828），卡片/页面明度差拉开，层次更清楚
    · 新增 Brush.RowSelected（勾选行底色）与 Brush.FocusRing（键盘焦点环）
    · 新增 Thickness.Page / PageTop / PageGap / Page（紧凑版）响应式页面边距令牌，
      由 MainWindow 在 ActualWidth < 1080 时切换为紧凑值（DynamicResource 引用）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════════ 颜色（Color，写渐变/动画时要用） ══════════════ -->
    <Color x:Key="Color.Accent">#FF2563EB</Color>
    <Color x:Key="Color.AccentDeep">#FF1D4ED8</Color>
    <Color x:Key="Color.Accent2">#FF0EA5E9</Color>
    <Color x:Key="Color.Bg">#FFF3F5F9</Color>
    <!-- 分组头/吸顶头的底色渐变端点（GradientStop.Color 只吃 Color，不吃 Brush） -->
    <Color x:Key="Color.HeadTop">#FFFFFFFF</Color>
    <Color x:Key="Color.HeadBot">#FFFAFBFE</Color>
    <!-- 阴影色（对话框/工具条 DropShadowEffect 的 Color 属性） -->
    <Color x:Key="Color.ShadowFx">#FF0F1B33</Color>
    <!-- 键盘焦点环（GradientStop/Effect 只吃 Color 的场合） -->
    <Color x:Key="Color.FocusRing">#FF93B4FB</Color>

    <!-- ══════════════ 基础画刷 ══════════════ -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#FFF3F5F9" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Line" Color="#FFE4E8F0" />
    <SolidColorBrush x:Key="Brush.LineSoft" Color="#FFEFF1F6" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FF101828" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#FF5D6576" />
    <SolidColorBrush x:Key="Brush.Muted2" Color="#FF98A1B2" />
    <SolidColorBrush x:Key="Brush.Muted3" Color="#FFC6CCDA" />

    <!-- ══════════════ 品牌色 ══════════════ -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF2563EB" />
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#FF0EA5E9" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FFEFF6FF" />
    <SolidColorBrush x:Key="Brush.AccentLine" Color="#FFBFDBFE" />
    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2563EB" Offset="0" />
        <GradientStop Color="#FF0EA5E9" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1D4ED8" Offset="0" />
        <GradientStop Color="#FF0284C7" Offset="1" />
    </LinearGradientBrush>

    <!-- ══════════════ 语义色 ══════════════ -->
    <SolidColorBrush x:Key="Brush.Warn" Color="#FFB45309" />
    <SolidColorBrush x:Key="Brush.WarnBg" Color="#FFFFF9EB" />
    <SolidColorBrush x:Key="Brush.WarnLine" Color="#FFF6E7C1" />
    <SolidColorBrush x:Key="Brush.Err" Color="#FFDC2626" />

    <!-- ══════════════ 行状态 ══════════════ -->
    <SolidColorBrush x:Key="Brush.RowHover" Color="#FFF4F7FD" />
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#FFE8ECF5" />
    <!-- 勾选行底色：v2 新增。勾选不只反映在复选框上，整行淡淡铺一层品牌浅蓝，
         扫一眼就知道哪些会被导出（可用性改进 #1） -->
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#FFEDF3FF" />
    <SolidColorBrush x:Key="Brush.NameOff" Color="#FFA6AEBE" />
    <SolidColorBrush x:Key="Brush.IdOff" Color="#FFC2C8D5" />

    <!-- ══════════════ 键盘焦点 ══════════════ -->
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#FF93B4FB" />

    <!-- ══════════════ 标签（来源 / 置灰） ══════════════ -->
    <SolidColorBrush x:Key="Brush.TagSrcFg" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="Brush.TagSrcBg" Color="#FFEFF6FF" />
    <SolidColorBrush x:Key="Brush.TagSrcLine" Color="#FFDBEAFE" />
    <SolidColorBrush x:Key="Brush.TagDimFg" Color="#FF98A1B2" />
    <SolidColorBrush x:Key="Brush.TagDimBg" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="Brush.TagDimLine" Color="#FFE7EAF1" />

    <!-- ══════════════ 玻璃拟态（工具条 / 底栏） ══════════════ -->
    <!-- v2：把透明度从 0.78 提到 0.85 —— 没有实时模糊的「假玻璃」越透越显脏，
         提高一档更像实心浅卡，边界靠描边表达 -->
    <SolidColorBrush x:Key="Brush.Glass" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="Brush.GlassBorder" Color="#F0E4E8F0" />
    <SolidColorBrush x:Key="Brush.GlassInput" Color="#F2FFFFFF" />

    <!-- ══════════════ 日志面板 ══════════════ -->
    <SolidColorBrush x:Key="Brush.LogBg" Color="#FFFAFBFE" />
    <SolidColorBrush x:Key="Brush.LogFg" Color="#FF333B4A" />
    <SolidColorBrush x:Key="Brush.LogTs" Color="#FFA2AAB9" />
    <SolidColorBrush x:Key="Brush.LogHead" Color="#FF5D6576" />
    <SolidColorBrush x:Key="Brush.LogAct" Color="#FF8A93A6" />
    <SolidColorBrush x:Key="Brush.LogOk" Color="#FF067647" />
    <SolidColorBrush x:Key="Brush.LogSkip" Color="#FF0E7490" />
    <SolidColorBrush x:Key="Brush.LogFail" Color="#FFDC2626" />
    <SolidColorBrush x:Key="Brush.LogDone" Color="#FF1D4ED8" />

    <!-- ══════════════ 滚动条 ══════════════ -->
    <SolidColorBrush x:Key="Brush.Scroll" Color="#FFCBD2E1" />
    <SolidColorBrush x:Key="Brush.ScrollHi" Color="#FFAAB4C9" />

    <!-- ══════════════ 胶囊 / 头部渐变 / 骨架屏 ══════════════ -->
    <SolidColorBrush x:Key="Brush.ChipBg" Color="#FFEFF1F6" />
    <SolidColorBrush x:Key="Brush.HeadTop" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.HeadBot" Color="#FFFAFBFE" />
    <SolidColorBrush x:Key="Brush.PillRing" Color="#FFEEF1F7" />
    <SolidColorBrush x:Key="Brush.PillRingFull" Color="#FFBFD3FE" />
    <SolidColorBrush x:Key="Brush.GradH1" Color="#FFF9FAFE" />
    <SolidColorBrush x:Key="Brush.GradH2" Color="#FFEFF2FA" />
    <SolidColorBrush x:Key="Brush.Skel1" Color="#FFE9ECF4" />
    <SolidColorBrush x:Key="Brush.Skel2" Color="#FFF0F2F8" />

    <!-- ══════════════ 搜索命中高亮 ══════════════ -->
    <SolidColorBrush x:Key="Brush.HighlightBg" Color="#FFFDE68A" />
    <SolidColorBrush x:Key="Brush.HighlightFg" Color="#FF7C2D12" />

    <!-- ══════════════ v3「清单工作台」新增 ══════════════ -->
    <!--
        实心按钮专用色：**不跟随主题变浅**。
        深色主题里 Brush.Accent 会提到 #60A5FA（深底上需要更亮的蓝才看得清），
        但白字压在该色上只有 2.54:1，实心主按钮会糊成一片；
        所以实心底一律用 600 号色（白字 5.17:1），亮蓝只用于文字/描边。
    -->
    <SolidColorBrush x:Key="Brush.BrandSolid" Color="#FF2563EB" />
    <SolidColorBrush x:Key="Brush.BrandSolidHover" Color="#FF1D4ED8" />

    <!-- 浮动选择条：浅色主题下是深色面（明确「浮层」），深色主题下反转为浅色面 -->
    <SolidColorBrush x:Key="Brush.Bar" Color="#FF1B2130" />
    <SolidColorBrush x:Key="Brush.BarText" Color="#FFF4F7FC" />
    <SolidColorBrush x:Key="Brush.BarText2" Color="#FFA8B2C4" />
    <SolidColorBrush x:Key="Brush.BarLine" Color="#FF333D4F" />
    <SolidColorBrush x:Key="Brush.BarHover" Color="#FF2A3346" />
    <SolidColorBrush x:Key="Brush.BarOnSelected" Color="#FF2A3346" />

    <!--
        命令条里的分段器轨道与选中底（v3.6 修正）。
        原来 轨道 #EEF1F7 / 选中底 #FFFFFF / 描边 #E4E8F0 三层都挤在 10–20 的明度差里，
        125% DPI 下 1px 描边被抗锯齿吃掉一半像素，看起来就是「边框有时候不显示」。
        现在把轨道压深一档、描边单独加深，拉开三层对比：
          轨道 → 选中底 22，选中底 → 描边 24，描边 → 轨道 34（原来的 10）。
    -->
    <SolidColorBrush x:Key="Brush.SegTrack" Color="#FFE7EBF3" />
    <SolidColorBrush x:Key="Brush.SegOn" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SegOnLine" Color="#FFCBD5E4" />

    <!--
        未勾选复选框的描边（v3.4 修正）。
        原来用 Brush.Line(#E4E8F0) 压在 Brush.RowAlt(#E8ECF5) 上，两者只差 1.06:1，
        19px 的框在白卡上几乎消失，用户读不出「这里可以勾」。
        现在改成白底 + 1.5px #8791A3：对白底 3.18:1，达到 WCAG 1.4.11 对非文本控件的 3:1 门槛。
    -->
    <SolidColorBrush x:Key="Brush.CheckLine" Color="#FF8791A3" />
    <SolidColorBrush x:Key="Brush.CheckFill" Color="#FFFFFFFF" />

    <!--
        列表底部渐隐（v3.4 新增）。卡片高度不是行高整数倍，最后一行必然被下沿切一半，
        「字被切断」看起来像渲染错误，用 28px 渐变把它收掉。
        透明端是 #00FFFFFF（= Brush.Card 的透明版本），换主题时这一条要跟着改。
    -->
    <LinearGradientBrush x:Key="Brush.ListFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- 状态条 / Toast -->
    <SolidColorBrush x:Key="Brush.ToastOk" Color="#FF4ADE80" />

    <!-- v3 字号：标题栏收小（44 高的标题栏装不下 24px 标题），状态条压到 11.5 -->
    <sys:Double x:Key="FontSize.Titlebar">13.5</sys:Double>
    <sys:Double x:Key="FontSize.Seg">12</sys:Double>
    <sys:Double x:Key="FontSize.Status">11.5</sys:Double>
    <sys:Double x:Key="FontSize.Micro">10.5</sys:Double>

    <CornerRadius x:Key="Corner.SelectionBar">12</CornerRadius>
    <CornerRadius x:Key="Corner.Menu">10</CornerRadius>

    <!-- ══════════════ 字体 ══════════════ -->
    <!-- 逗号分隔即回退链；v2 把 Segoe UI Variable 提到最前（Win11 自带），
         西文走 Fluent 原生字形、中文回退雅黑，混排更协调 -->
    <FontFamily x:Key="FontFamily.Ui">Segoe UI Variable Text, Segoe UI, HarmonyOS Sans SC, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="FontFamily.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!--
        ══════════════ 字号 ══════════════
        v2 重设计不再按「原版 pt 换算」钉值，而是按信息层级重排（详见 docs/UI-DESIGN.md §3）：
        · 标题/正文加大半级到一级，长会话阅读更省力；ID/标签等辅助信息维持小号
        · 全部取 0.5 的倍数，保证 100%/125%/150% 缩放下不会出现半像素模糊
    -->
    <sys:Double x:Key="FontSize.Title">24</sys:Double>
    <sys:Double x:Key="FontSize.Sub">12.5</sys:Double>
    <sys:Double x:Key="FontSize.Row">13.5</sys:Double>
    <sys:Double x:Key="FontSize.RowId">11.5</sys:Double>
    <sys:Double x:Key="FontSize.Tag">11</sys:Double>
    <sys:Double x:Key="FontSize.Log">11.5</sys:Double>

    <!-- 兼容旧键名（对话框标题 / 统计数字 / 正文 / 辅助 / 小字） -->
    <sys:Double x:Key="FontSize.DialogTitle">21</sys:Double>
    <sys:Double x:Key="FontSize.Stat">22</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Aux">12.5</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>

    <sys:Double x:Key="FontSize.StatsNumber">22</sys:Double>
    <sys:Double x:Key="FontSize.Chip">12</sys:Double>
    <sys:Double x:Key="FontSize.Bottom">12.5</sys:Double>

    <!-- ══════════════ 圆角 ══════════════ -->
    <!-- v2 圆角阶：4 / 6 / 8 / 12。收小一号，配 hairline 描边走「清晰卡片」而不是「气球」 -->
    <CornerRadius x:Key="Corner.Card">12</CornerRadius>
    <CornerRadius x:Key="Corner.Bar">9</CornerRadius>
    <CornerRadius x:Key="Corner.Row">8</CornerRadius>
    <CornerRadius x:Key="Corner.Tag">6</CornerRadius>
    <CornerRadius x:Key="Corner.Pill">15</CornerRadius>
    <CornerRadius x:Key="Corner.Inner">10</CornerRadius>

    <!-- ══════════════ 间距（4px 栅格） ══════════════ -->
    <sys:Double x:Key="Space.Page">24</sys:Double>
    <sys:Double x:Key="Space.Card">16</sys:Double>
    <sys:Double x:Key="Space.Row">8</sys:Double>

    <!--
        ══════════════ 响应式页面边距（v2 新增） ══════════════
        MainWindow.xaml 用 DynamicResource 引用这组 Thickness；
        MainWindow 在 ActualWidth ≥ 1080 时写舒适值、< 1080 时写紧凑值，
        实现「同一份 XAML，宽窄窗都有合理留白」。compact 版也在此给出默认值，
        保证设计器预览与运行首帧一致。
    -->
    <Thickness x:Key="Thickness.Page">24,0,24,0</Thickness>
    <Thickness x:Key="Thickness.PageTop">24,12,24,0</Thickness>
    <Thickness x:Key="Thickness.PageGap">24,10,24,0</Thickness>
    <Thickness x:Key="Thickness.PageCompact">14,0,14,0</Thickness>
    <Thickness x:Key="Thickness.PageTopCompact">14,8,14,0</Thickness>
    <Thickness x:Key="Thickness.PageGapCompact">14,8,14,0</Thickness>

    <!--
        ══════════════ 关于「没有被引用的令牌」 ══════════════
        下列令牌当前没有任何 StaticResource / TryFindResource 引用，但**不要删**：
        它们是设计令牌契约的一部分（docs/ARCHITECTURE.md §3 的令牌表 +
        .workbuddy/checks/check_csproj.py 的 REQUIRED_TOKEN_KEYS），删掉会让静态自查直接 FAIL，
        也会让「改主题只改 Tokens」这条约定失效（例如 Color.* 是给后续画笔代码取值用的口径）。

        Color.Accent / Color.AccentDeep / Color.Accent2 / Color.Bg
        Brush.Accent2 / Brush.HeadTop / Brush.HeadBot / Brush.GradH1 / Brush.GradH2
        FontSize.Sub / Space.Page / Space.Card / Space.Row
    -->

</ResourceDictionary>
