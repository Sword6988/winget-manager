<?xml version="1.0" encoding="utf-8"?>
<!--
  AOT 发布配置：dotnet publish -c Release -r win-x64 -p:PublishProfile=win-x64
  产物：publish\win-x64\WingetManager.exe（未打包、自包含、Native AOT）
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\publish\win-x64\</PublishDir>

    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Native AOT 与 PublishSingleFile 互斥：AOT 产物已是原生 exe -->

    <!-- Native AOT 的 ILC 分析器只报警告；这里不当作错误，避免版本升级即构建失败 -->
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
</Project>
