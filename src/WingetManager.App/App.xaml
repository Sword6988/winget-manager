<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WingetManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Mica 背景下的主题桥接资源（深浅色由系统决定，P1-6） -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppCardBrush" Color="#F7F8FC" />
          <SolidColorBrush x:Key="AppSubtleTextBrush" Color="#6A7183" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1F2026" />
          <SolidColorBrush x:Key="AppCardBrush" Color="#26272F" />
          <SolidColorBrush x:Key="AppSubtleTextBrush" Color="#A0A7B8" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
