<Project Sdk="Microsoft.NET.Sdk">

  <!-- ═══════════════════════════════════════════════════════════════════
       Core 类库：不引用任何 WinUI 类型，保证解析/判定/导出全部可 xUnit 直测。
       见 docs/ARCHITECTURE.md §1.3
       ═══════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WingetManager</RootNamespace>
    <AssemblyName>WingetManager.Core</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <IsTrimmable>true</IsTrimmable>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Text.Json 源生成器：显式 8.0.x（AOT 路径必须走源生成，禁反射） -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
